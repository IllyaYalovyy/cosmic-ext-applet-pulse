# Upstream binary RPM. Compile with scripts/build-release.sh on the target Fedora.
# This spec packages the freshly built payload; it is not a Fedora dist-git SRPM.
%global debug_package %{nil}
%global appid io.github.illyayalovyy.Pulse
Name: cosmic-ext-applet-pulse
Version: @VERSION@
Release: 1%{?dist}
Summary: Resource meters for the COSMIC panel and dock
License: @LICENSE@
URL: https://github.com/IllyaYalovyy/cosmic-ext-applet-pulse
Source0: %{name}-%{version}-payload.tar.gz
ExclusiveArch: x86_64 aarch64
Requires: cosmic-panel
Requires: libwayland-client
Requires: hicolor-icon-theme
# Generated by RPM's ELF dependency scanner from the release executable.
@ELF_REQUIRES@

%description
Pulse displays per-core CPU, RAM, swap, network traffic, disk space and I/O,
and supported GPU utilization and VRAM in the COSMIC panel or dock.

%prep
%setup -q

%build
# The release script compiled this payload from the matching source revision.

%install
mkdir -p %{buildroot}%{_bindir} %{buildroot}%{_datadir}
install -pm0755 usr/bin/%{name} %{buildroot}%{_bindir}/%{name}
cp -a usr/share/. %{buildroot}%{_datadir}/

%check
test -x %{buildroot}%{_bindir}/%{name}
test -f %{buildroot}%{_datadir}/applications/%{appid}.desktop

%files
%license LICENSE third-party-licenses
%doc README.md CHANGELOG.md
%{_bindir}/%{name}
%{_datadir}/applications/%{appid}.desktop
%{_datadir}/metainfo/%{appid}.metainfo.xml
%{_datadir}/icons/hicolor/scalable/apps/%{appid}-symbolic.svg
